// This is your Prisma schema file.
// When moving to Supabase: change provider to "postgresql"
// and set DATABASE_URL to your Supabase connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Every unique domain ever scanned
model Domain {
  id                       String      @id @default(cuid())
  domain                   String      @unique
  url                      String?
  firstScanned             DateTime    @default(now())
  lastScanned              DateTime    @updatedAt
  latestGeoScore           Int         @default(0)
  latestCitationRate       Int         @default(0)
  latestZeroClickResilience Int        @default(0)
  latestInfoGainScore      Int         @default(0)
  latestEntityScore        Int         @default(0)
  latestVectorReadiness    Int         @default(0)
  category                 String      @default("General")
  scanCount                Int         @default(1)
  status                   String      @default("MODERATE") // OPTIMAL | MODERATE | AT_RISK
  trendDelta               Int         @default(0)
  trend                    String      @default("flat") // up | down | flat

  scanEvents               ScanEvent[]

  @@index([latestGeoScore])
  @@index([domain])
}

// One row per individual scan - powers sparklines and history
model ScanEvent {
  id                  String   @id @default(cuid())
  domain              String
  scannedAt           DateTime @default(now())
  geoScore            Int
  zeroClickResilience Int      @default(0)
  citationRate        Int      @default(0)
  infoGainScore       Int      @default(0)
  entityScore         Int      @default(0)
  vectorReadiness     Int      @default(0)
  status              String   @default("MODERATE")
  sessionId           String?  // anonymous browser session
  isLiveScan          Boolean  @default(false)
  rawReport           String?  // JSON blob of full GeoAuditReport

  domainRef            Domain?  @relation(fields: [domainId], references: [id])
  domainId             String?

  @@index([domain])
  @@index([scannedAt])
}

// Anonymous browser sessions - each session has its own watchlist
model Session {
  id          String   @id  // nanoid from browser
  createdAt   DateTime @default(now())
  // @deprecated: use WatchlistEntry relation instead. Kept for rollback safety.
  watchlist   String   @default("[]") // JSON array of domain strings

  watchlistEntries WatchlistEntry[]
}

// Live machine-to-machine traffic & citation events
model TelemetryEvent {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  type            String   // AI_CITATION | AGENT_TX | P2P_MESH_CLICK | GEO_INDEX_PING
  source          String   // e.g. Perplexity Pro Sonar, OpenAI SearchBot
  domain          String   // e.g. stripe.com
  destinationUrl  String   // e.g. https://stripe.com/.well-known/agent.json
  intent          String   // Action or reasoning intent
  geoScoreAtTime  Int      @default(80)
  settlementValue Float?   // Monetary escrow value for direct purchases

  @@index([timestamp])
  @@index([domain])
  @@index([type])
}

// API keys for authenticated access and rate limiting
model ApiKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique       // sha256 of the full key - plaintext is NEVER stored
  keyPrefix   String                  // display prefix, e.g. "or-live_ab12cd34"
  name        String                  // "My Production Key"
  domain      String?                 // optional: restrict to a specific domain
  tier        String    @default("free") // free | pro | enterprise
  rateLimit   Int       @default(100) // requests per hour / burst
  usageCount  Int       @default(0)   // total lifetime calls
  overageCount Int      @default(0)   // total calls beyond daily plan limit
  overageCostCents Int  @default(0)   // total accrued overage value in USD cents
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(true)
  userId      String?                 // optional: link to owner

  owner       User?     @relation(fields: [userId], references: [id])

  @@index([keyHash])
  @@index([keyPrefix])
  @@index([tier])
  @@index([userId])
}

// Registered users
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?                    // null for OAuth-only users
  role          String    @default("user") // user | admin
  tier          String    @default("free") // free | pro | enterprise
  // @deprecated: use WatchlistEntry relation instead. Kept for rollback safety.
  watchlist     String    @default("[]")   // JSON array of domain strings
  avatarUrl     String?
  provider      String    @default("email") // email | google | github
  providerId    String?                     // OAuth provider user ID
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  tokenVersion  Int       @default(1)

  apiKeys          ApiKey[]
  registeredSites  RegisteredSite[]
  watchlistEntries WatchlistEntry[]
  passwordResetTokens PasswordResetToken[]

  // Lemon Squeezy Subscription Details
  lemonCustomerId          String?
  lemonSubscriptionId      String?
  lemonSubscriptionItemId  String?   // ID of metered usage subscription item
  lemonVariantId           String?
  subscriptionStatus       String?   // active | on_trial | paused | past_due | unpaid | cancelled | expired
  subscriptionRenewsAt     DateTime?
  subscriptionEndsAt       DateTime?
  lemonPortalUrl           String?

  @@index([email])
  @@index([provider, providerId])
  @@index([lemonCustomerId])
  @@index([lemonSubscriptionId])
}

// Sites where the user has installed & verified the CiteRoute tag.
// Distinct from watchlist (which monitors any domain for GEO score).
// A domain can only be registered once per user.
// Adding requires server-side re-verification that the tag is live.
model RegisteredSite {
  id           String   @id @default(cuid())
  userId       String
  domain       String   // exact hostname e.g. "www.uselocalpdf.com"
  verifiedAt   DateTime @default(now())
  addedAt      DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@index([domain])
}

// Lightweight record of when track.js last loaded on a domain.
// Updated on every call to /api/v1/track, human or AI.
// Used by /api/v1/verify so verification works on all frameworks
// (Next.js Script component, React, SPAs) not just static HTML.
model TagHeartbeat {
  domain    String   @id  // unique per domain - cheap upsert
  lastSeen  DateTime @default(now())
  firstSeen DateTime @default(now())

  @@index([lastSeen])
}

// Persistent rate limiting - survives serverless cold starts unlike in-memory Maps.
// Rows are cheap and auto-expired by the cleanup cron.
model RateLimitRecord {
  id          String   @id @default(cuid())
  identifier  String   // IP address or "email:<email>"
  action      String   // "scan" | "login" | "register"
  windowStart DateTime // Start of the current window
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([identifier, action])
  @@index([identifier, action])
  @@index([windowStart])
}

// Relational watchlist entries - replaces the legacy JSON string columns on User and Session.
// A single row represents one domain tracked by one user or anonymous session.
model WatchlistEntry {
  id        String   @id @default(cuid())
  domain    String   // e.g. "stripe.com"
  addedAt   DateTime @default(now())

  // Either userId OR sessionId must be set, not both
  userId    String?
  sessionId String?

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@unique([sessionId, domain])
  @@index([userId])
  @@index([sessionId])
  @@index([domain])
}

// Email verification for anonymous scan gating.
// Anonymous users must verify their email before scanning.
// OTP codes expire after 10 minutes.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit numeric code
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
}

// Enterprise Data Subscription inquiries / high-ticket leads
model EnterpriseInquiry {
  id             String   @id @default(cuid())
  name           String
  email          String
  company        String
  website        String?
  product        String   // "Vertical Leaderboard" | "Competitor Benchmarking" | "Full Index Access"
  price          String?  // "$500/month", "$1,500/month", "$5,000/month"
  industry       String?
  deliveryFormat String?  // "Private REST API Key" | "Automated Weekly CSV Export" | etc.
  message        String?
  status         String   @default("pending") // pending | contacted | qualified | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

// Password reset tokens with single-active-token invalidation and replay protection.
// When a new reset request is made, all older active tokens for the user are invalidated.
model PasswordResetToken {
  id        String   @id // unique token id
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Revoked session tokens (jti blacklist) for instantaneous post-logout invalidation
model RevokedToken {
  jti       String   @id // unique JWT ID
  userId    String?
  expiresAt DateTime     // timestamp when the JWT would naturally expire
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

