# OmniRoute Environment Variables Configuration

# ── Database (Turso / libSQL Recommended for Vercel Serverless) ──
# 1. Create a free database on https://turso.tech
# 2. Set the connection URL (e.g., libsql://your-db-org.turso.io)
# 3. Set your Turso Auth Token
DATABASE_URL="file:./omniroute.db"
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-jwt-auth-token"

# ── Optional: Live AI Foundation Model Verification Keys ──
# Enables genuine real-time citation lookups in the AI Simulator and Scanner
# PERPLEXITY_API_KEY="pplx-..."
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# ── Optional: Transactional Email Alerts (Resend) ──
# RESEND_API_KEY="re_..."
# ALERT_FROM_EMAIL="alerts@omniroute.ai"

# ── App Public URL (For dynamic OG images and webhooks) ──
# NEXT_PUBLIC_APP_URL="https://omniroute.vercel.app"

# ── Admin Dashboard & API Key Management ──
# Secret passphrase for legacy API key management (optional with user auth)
# ADMIN_SECRET="your-strong-admin-passphrase-here"

# ── JWT Session Secret ──
# Used to sign authentication cookies. Change this in production!
# JWT_SECRET="your-jwt-secret-change-in-production"

# ── OAuth Providers (Optional) ──
# Google: Create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub: Create at https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ── Vercel Cron Job Authentication ──
# CRON_SECRET="your-cron-secret-here"
