# CiteRoute Environment Variables Configuration

# ── Database (Turso / libSQL Recommended for Vercel Serverless) ──
# 1. Create a free database on https://turso.tech
# 2. Set the connection URL (e.g., libsql://your-db-org.turso.io)
# 3. Set your Turso Auth Token
DATABASE_URL="file:./citeroute.db"
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-jwt-auth-token"

# ── CiteRoute AI Engine ──
# Powers the AI-driven citation intelligence, schema generation, and report analysis.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# -- AI Engine API Keys (Optional - for Live Per-Engine Citation Data) --
# Users can configure these in the UI (Settings → Engine Integrations).
# When set server-side, they provide real citation data in the GEO audit scan.
# Keys are NEVER logged or stored; they are used per-request only.
# Perplexity: https://docs.perplexity.ai/
# PERPLEXITY_API_KEY="pplx-..."
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."
# Google Gemini: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="AIza..."

# ── Optional: Transactional Email Alerts (Resend) ──
# RESEND_API_KEY="re_..."
# ALERT_FROM_EMAIL="alerts@citeroute.com"

# ── App Public URL (For dynamic OG images and webhooks) ──
# NEXT_PUBLIC_APP_URL="https://citeroute.vercel.app"

# ── Admin Dashboard & API Key Management ──
# Secret passphrase for legacy API key management (optional with user auth)
# ADMIN_SECRET="your-strong-admin-passphrase-here"

# ── JWT Session Secret ──
# Used to sign authentication cookies. Change this in production!
# JWT_SECRET="your-jwt-secret-change-in-production"

# ── OAuth Providers (Optional) ──
# Google: Create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub: Create at https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ── Vercel Cron Job Authentication ──
# CRON_SECRET="your-cron-secret-here"

# ── Google Search Console & Google Analytics 4 (GA4) ──
# 1. Google Site Verification token (from Search Console -> HTML tag method)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"

# 2. Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── IndexNow API Key (Bing, Yandex, Seznam, Naver Instant Indexing) ──
# Host at /<key>.txt and submit via https://api.indexnow.org/indexnow
# INDEXNOW_API_KEY="afd4693d327c47b3852cece74c5d52ab"

# ── Lemon Squeezy Payment Gateway & Webhooks ──
# 1. API Key: Settings -> API Keys
# LEMONSQUEEZY_API_KEY="eyJhbGciOi..."
# 2. Store ID: Settings -> Stores
# LEMONSQUEEZY_STORE_ID="12345"
# 3. Webhook Secret: Settings -> Webhooks (Signing secret for HMAC-SHA256)
# LEMONSQUEEZY_WEBHOOK_SECRET="your-32-char-signing-secret"
# 4. Product Variant IDs: Products -> Share -> Variant ID
# LEMONSQUEEZY_VARIANT_ID_PRO="123456"
# LEMONSQUEEZY_VARIANT_ID_AGENCY="123457"
